# Copy to .env; .env is gitignored.

# Local inference (default backend). Leave as-is unless Ollama runs elsewhere.
OLLAMA_HOST=http://localhost:11434

# Only needed for the openai:* backend, which is retained for benchmarking.
# Sending receptor context off-premise is a data-governance decision — check
# before enabling this on an internal target.
# OPENAI_API_KEY=

# Override the default data directory.
# MOLGEN_DATA_DIR=/path/to/test_data
